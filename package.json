{
  "name": "whatever-engine",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.12.0" },
  "workspaces": [
    "runtime"
  ],
  "scripts": {
    "docs:install": "npm --prefix website ci",
    "docs:generate": "npm --prefix website run generate",
    "docs:dev": "npm --prefix website run dev",
    "docs:build": "npm --prefix website run build",
    "docs:check-examples": "npm run build:runtime && node website/scripts/check-examples.mjs",
    "docs:preview": "npm --prefix website run preview",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "build:runtime": "npm run build --workspace @whatever-engine/api",
    "build:guest": "node tools/build-script-guest.ts",
    "build:native": "node tools/build-native.ts",
    "test:embedded": "vitest run tools/tests/embedded-runtime.test.ts --testTimeout=60000",
    "test:coinwatch": "vitest run tools/tests/coinwatch.test.ts --testTimeout=120000",
    "test:mods": "vitest run tools/tests/shipped-mods.test.ts --testTimeout=30000",
    "test:network": "vitest run tools/tests/network.test.ts && tsc --project tools/tests/tsconfig.network.json",
    "test:snapshots": "vitest run tools/tests/snapshots.test.ts",
    "test:markbench": "vitest run tools/tests/markbench.test.ts --testTimeout=180000",
    "test:components": "vitest run tools/tests/components.test.ts",
    "test:runtime": "vitest run tools/tests/input.test.ts && tsc --project tools/tests/tsconfig.runtime.json",
    "test:server": "vitest run tools/tests/server.test.ts --testTimeout=30000",
    "test:project": "vitest run tools/tests/project.test.ts --testTimeout=60000",
    "package:editor": "node tools/package-editor.ts",
    "package:installers": "node tools/package-installers.ts",
    "check:versions": "node tools/check-versions.ts",
    "test:guest": "node tools/build-native.ts --test-vm",
    "test:native": "node tools/build-native.ts --test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "esbuild": "0.28.2",
    "smol-toml": "1.9.1",
    "vitest": "5.1.0"
  },
  "version": "0.7.0"
}
