{
  "name": "whatever-engine",
  "private": true,
  "workspaces": [
    "runtime"
  ],
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "build:runtime": "bun run --cwd runtime build",
    "prepare:bun": "bun tools/prepare-bun.ts",
    "build:bun": "bun tools/build-bun.ts",
    "build:host": "bun tools/build-mod-host.ts",
    "test:mods": "bun test tools/tests/shipped-mods.test.ts --timeout 30000",
    "test:network": "bun test tools/tests/network.test.ts && bun runtime/node_modules/typescript/bin/tsc --project tools/tests/tsconfig.network.json",
    "test:runtime": "bun runtime/node_modules/typescript/bin/tsc --project tools/tests/tsconfig.runtime.json",
    "test:server": "bun test tools/tests/server.test.ts --timeout 30000",
    "test:project": "bun test tools/tests/project.test.ts --timeout 60000",
    "test:host": "bun test tools/tests/mod-host.test.ts --timeout 30000",
    "package:editor": "bun tools/package-editor.ts"
  },
  "dependencies": {
    "@types/bun": "^1.3.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4"
  }
}
