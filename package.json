{
  "name": "whatever-engine",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "workspaces": [
    "runtime"
  ],
  "scripts": {
    "docs:install": "bun install --cwd website --frozen-lockfile",
    "docs:generate": "bun run --bun --cwd website generate",
    "docs:dev": "bun run --bun --cwd website dev",
    "docs:build": "bun run --bun --cwd website build",
    "docs:check-examples": "bun run build:runtime && bun website/scripts/check-examples.mjs",
    "docs:preview": "bun run --bun --cwd website preview",
    "format": "bun run --bun biome format --write .",
    "format:check": "bun run --bun biome format .",
    "build:runtime": "bun run --bun --cwd runtime build",
    "build:guest": "bun tools/build-script-guest.ts",
    "build:native": "bun tools/build-native.ts",
    "test:embedded": "bun test ./tools/tests/embedded-runtime.test.ts --timeout 60000",
    "test:coinwatch": "bun test ./tools/tests/coinwatch.test.ts --timeout 120000",
    "test:mods": "bun test ./tools/tests/shipped-mods.test.ts --timeout 30000",
    "test:network": "bun test ./tools/tests/network.test.ts && bun run --bun tsc --project tools/tests/tsconfig.network.json",
    "test:snapshots": "bun test ./tools/tests/snapshots.test.ts",
    "test:markbench": "bun test ./tools/tests/markbench.test.ts --timeout 180000",
    "test:components": "bun test ./tools/tests/components.test.ts",
    "test:runtime": "bun test ./tools/tests/input.test.ts && bun run --bun tsc --project tools/tests/tsconfig.runtime.json",
    "test:server": "bun test ./tools/tests/server.test.ts --timeout 30000",
    "test:project": "bun test ./tools/tests/project.test.ts --timeout 60000",
    "package:editor": "bun tools/package-editor.ts",
    "package:installers": "bun tools/package-installers.ts",
    "check:versions": "bun tools/check-versions.ts",
    "test:guest": "bun tools/build-native.ts --test-vm",
    "test:native": "bun tools/build-native.ts --test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "esbuild": "0.28.2",
    "smol-toml": "1.9.1",
    "@types/bun": "^1.3.14"
  },
  "version": "0.8.0",
  "packageManager": "bun@1.4.2"
}
