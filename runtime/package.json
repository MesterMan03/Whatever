{
  "name": "@whatever-engine/api",
  "author": "Mester",
  "license": "Apache-2.0",
  "description": "TypeScript scripting API for Whatever Engine mods",
  "version": "0.7.0",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build:bundle": "node ../tools/build-script-assets.ts",
    "build:types": "dts-bundle-generator --project tsconfig.dts.json --out-file dist/index.d.ts src/index.ts",
    "build": "npm run build:types && npm run build:bundle",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22",
    "dts-bundle-generator": "^9.5.1",
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MesterMan03/Whatever.git",
    "directory": "runtime"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts"
  ]
}
