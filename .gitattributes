# Native fork patches need LF endings; blank context markers contain a required space.
vendor/patches/*.patch text eol=lf whitespace=-blank-at-eol

# Keep formatted mod sources stable across Windows and Unix checkouts.
biome.json text eol=lf
mods/**/*.js text eol=lf
